---
interface Props {
  name: string;
  role: string;
  bio: string;
  photo?: string;
  isPI?: boolean;
  placeholder?: boolean;
}
const { name, role, bio, photo, isPI = false, placeholder = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const initials = name
  .split(" ")
  .filter((w) => w.length > 1)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

// Bios may carry a blank-line paragraph break -- split so each renders as its own <p>.
const paragraphs = bio.split(/\n{2,}/);
---

<div
  class:list={[
    "flex flex-col border p-6",
    placeholder
      ? "border-dashed border-[var(--color-ink-faint)] bg-transparent"
      : "border-[var(--color-line)] bg-[var(--color-paper)]",
  ]}
>
  {photo ? (
    <img
      src={`${base}${photo}`}
      alt={name}
      class="h-16 w-16 rounded-full object-cover"
      width="160"
      height="160"
      loading="lazy"
    />
  ) : (
    <div
      class:list={[
        "flex h-16 w-16 items-center justify-center rounded-full font-display text-lg",
        placeholder
          ? "border border-dashed border-[var(--color-ink-faint)] text-[var(--color-ink-faint)]"
          : "bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)]",
      ]}
      aria-hidden="true"
    >
      {placeholder ? "?" : initials}
    </div>
  )}

  <h3 class="mt-4 font-display text-lg font-medium text-[var(--color-ink)]">{name}</h3>
  <p class="eyebrow mt-1">{isPI ? "Principal Investigator" : role}</p>
  <div class="mt-3 space-y-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</div>
