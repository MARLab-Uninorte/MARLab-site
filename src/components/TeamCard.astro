---
interface Props {
  name: string;
  role: string;
  bio: string;
  photo?: string;
  isPI?: boolean;
  placeholder?: boolean;
  links?: { label: string; href: string }[];
}
const { name, role, bio, photo, isPI = false, placeholder = false, links = [] } = Astro.props;
const base = import.meta.env.BASE_URL;

const initials = name
  .split(" ")
  .filter((w) => w.length > 1)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

// Bios may carry a blank-line paragraph break -- split so each renders as its own <p>.
const paragraphs = bio.split(/\n{2,}/);
---

<details
  class:list={[
    "group border p-6",
    placeholder
      ? "border-dashed border-[var(--color-ink-faint)] bg-transparent"
      : "border-[var(--color-line)] bg-[var(--color-paper)]",
  ]}
>
  <summary class="flex cursor-pointer list-none items-center gap-4 [&::-webkit-details-marker]:hidden">
    {photo ? (
      <img
        src={`${base}${photo}`}
        alt={name}
        class="h-16 w-16 shrink-0 rounded-full object-cover"
        width="160"
        height="160"
        loading="lazy"
      />
    ) : (
      <div
        class:list={[
          "flex h-16 w-16 shrink-0 items-center justify-center rounded-full font-display text-lg",
          placeholder
            ? "border border-dashed border-[var(--color-ink-faint)] text-[var(--color-ink-faint)]"
            : "bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)]",
        ]}
        aria-hidden="true"
      >
        {placeholder ? "?" : initials}
      </div>
    )}

    <span class="min-w-0 flex-1">
      <span class="block font-display text-lg font-medium leading-snug text-[var(--color-ink)]">{name}</span>
      <span class="eyebrow mt-1 block">{isPI ? "Principal Investigator" : role}</span>
    </span>

    <span
      class="shrink-0 font-mono text-base text-[var(--color-ink-faint)] transition-transform duration-200 group-open:rotate-45"
      aria-hidden="true"
    >
      +
    </span>
  </summary>

  <div class="mt-4 space-y-3 border-t border-[var(--color-line)] pt-4 text-sm leading-relaxed text-[var(--color-ink-soft)]">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>

  {links.length > 0 && (
    <div class="mt-4 flex flex-col gap-1">
      {links.map((link) => (
        <a
          href={`${base}${link.href}`}
          class="font-mono text-xs uppercase tracking-wide text-[var(--color-accent-ink)] hover:underline"
        >
          {link.label} →
        </a>
      ))}
    </div>
  )}
</details>
